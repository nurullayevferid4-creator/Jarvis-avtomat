# NÜMUNƏ fayldır. Real açarları BURAYA YAZMA, bu fayl GitHub-a gedir.
#
# Lokal sınaq üçün: bu faylı kopyala, adını .dev.vars qoy və orada doldur
# (.dev.vars və .env .gitignore ilə qorunur, GitHub-a düşmür).
# Cloudflare-də isə eyni adları Worker > Settings > Variables and Secrets bölməsinə
# "Secret" kimi yaz.

# --- Mütləq lazımdır (Secret) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PASSCODE=

# --- İstəyə bağlı (boş qalsa standart dəyər işləyir) ---
# Claude modeli (standart: claude-sonnet-5-5)
CLAUDE_MODEL=
# OpenAI modeli (standart: gpt-4o). Hesabında işləyən modelin adını OpenAI sənədindən yoxla.
OPENAI_MODEL=
# Canlı axtarış alətinin adı (standart: web_search; köhnəsi: web_search_preview)
OPENAI_WEB_SEARCH_TOOL=
# Səs (standart: onyx)
TTS_VOICE=

# --- Təhlükəsizlik limitləri (boş qalsa standart dəyər işləyir) ---
# Bir sorğuda maksimum alt tapşırıq (standart 4)
MAX_SUBTASKS=
# Bir sorğuda maksimum model çağırışı (standart 12)
MAX_MODEL_CALLS=
# Hər API çağırışı üçün saniyə limiti (standart 25)
CALL_TIMEOUT_SECONDS=
# Səhv parol cəhdi limiti (standart 5) və bloklanma müddəti saniyə ilə (standart 900)
LOGIN_MAX_FAILURES=
LOGIN_WINDOW_SECONDS=

# --- Xüsusiyyət bayraqları (boş qalsa hamısı açıqdır; söndürmək üçün 0 yaz) ---
# Səs: mikrofon və səsləndirmə
FEATURE_VOICE=
# Təsdiq mərkəzi API-si (/api/approvals)
FEATURE_APPROVALS=
# Bilik bazası API-si (/api/knowledge)
FEATURE_KNOWLEDGE=

# --- Sosial platformalar (hamısı istəyə bağlıdır; təyin olunmayan platforma "NOT CONNECTED" görünür) ---
# Ətraflı: SOCIAL.md. Hamısı Cloudflare-də "Secret" kimi yazılır (PUBLIC_BASE_URL istisna: sirr deyil).
# Worker-in ictimai https ünvanı (sonda / olmadan). OAuth callback və media ünvanı üçün.
PUBLIC_BASE_URL=
# Media faylları üçün imza açarı: uzun təsadüfi mətn (openssl rand -hex 32). Instagram media ünvanını imzalayır.
MEDIA_SIGNING_KEY=
# Saxlanmış platforma tokenlərini şifrələyən açar (openssl rand -hex 32). Yoxdursa tokenlər KV-də şifrəsiz qalır.
TOKEN_ENC_KEY=
# R2 binding JARVIS_MEDIA və KV binding JARVIS_KV wrangler.toml-da / Cloudflare panelində qoşulur (secret deyil).
# Telegram (BotFather-dan bot tokeni)
TELEGRAM_BOT_TOKEN=
# Webhook secret: 1-256 simvol, yalnız A-Z a-z 0-9 _ -  (openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=
# JARVIS-i idarə edə biləcək Telegram istifadəçi ID-ləri (vergüllə). Boşdursa HEÇ KİM idarə edə bilməz.
TELEGRAM_ALLOWED_CHAT_IDS=
# Paylaşımın gedəcəyi kanal (@kanal_adi və ya -100...); bot orada admin olmalıdır.
TELEGRAM_CHANNEL_ID=
# Instagram (Meta Developer > Instagram API with Instagram Login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# İstəyə bağlı (standart v25.0)
INSTAGRAM_API_VERSION=
# TikTok (developers.tiktok.com > Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# YouTube (Google Cloud > OAuth client, YouTube Data API v3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
