# NÜMUNƏ fayldır. Real açarları BURAYA YAZMA, bu fayl GitHub-a gedir.
#
# Lokal sınaq üçün: bu faylı kopyala, adını .dev.vars qoy və orada doldur
# (.dev.vars və .env .gitignore ilə qorunur, GitHub-a düşmür).
# Cloudflare-də isə eyni adları Worker > Settings > Variables and Secrets bölməsinə
# "Secret" kimi yaz.

# --- Mütləq lazımdır (Secret) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PASSCODE=

# --- İstəyə bağlı (boş qalsa standart dəyər işləyir) ---
# Claude modeli (standart: claude-sonnet-5-5)
CLAUDE_MODEL=
# OpenAI modeli (standart: gpt-4o). Hesabında işləyən modelin adını OpenAI sənədindən yoxla.
OPENAI_MODEL=
# Canlı axtarış alətinin adı (standart: web_search; köhnəsi: web_search_preview)
OPENAI_WEB_SEARCH_TOOL=
# Səs (standart: onyx)
TTS_VOICE=

# --- Təhlükəsizlik limitləri (boş qalsa standart dəyər işləyir) ---
# Bir sorğuda maksimum alt tapşırıq (standart 4)
MAX_SUBTASKS=
# Bir sorğuda maksimum model çağırışı (standart 12)
MAX_MODEL_CALLS=
# Hər API çağırışı üçün saniyə limiti (standart 25)
CALL_TIMEOUT_SECONDS=
# Səhv parol cəhdi limiti (standart 5) və bloklanma müddəti saniyə ilə (standart 900)
LOGIN_MAX_FAILURES=
LOGIN_WINDOW_SECONDS=

# --- Xüsusiyyət bayraqları (boş qalsa hamısı açıqdır; söndürmək üçün 0 yaz) ---
# Səs: mikrofon və səsləndirmə
FEATURE_VOICE=
# Təsdiq mərkəzi API-si (/api/approvals)
FEATURE_APPROVALS=
# Bilik bazası API-si (/api/knowledge)
FEATURE_KNOWLEDGE=

# --- Alətlər və öyrənmə bayraqları (boş qalsa açıqdır; söndürmək üçün 0 yaz) ---
# Alətlərin orkestratora qoşulması (bax docs/WIRING.md)
FEATURE_TOOLS=
# Nəticələrin qeyd edilməsi və Fərid-in təsdiqlədiyi öyrənmə qaydalarının oxunması
FEATURE_LEARNING=
# Söndürmə açarı: vergüllə icazə adları (məs. send.message). Təsdiqlənmiş çağırışı da dayandırır.
REVOKED_PERMISSIONS=

# --- Platforma credential adları (dəyərləri YALNIZ Cloudflare Secrets-ə yaz) ---
# Secret:
#   IG_FNPARFUM_TOKEN
#   TIKTOK_ACCESS_TOKEN
#   YOUTUBE_CLIENT_ID, YOUTUBE_CLIENT_SECRET, YOUTUBE_REFRESH_TOKEN
#   TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET
#   SHOPIFY_ADMIN_TOKEN  (və ya SHOPIFY_CLIENT_ID + SHOPIFY_CLIENT_SECRET)
# Gizli olmayan (Variables):
#   TELEGRAM_ALLOWED_CHAT_IDS   (vergüllə çat id-ləri; boşdursa heç bir çat qəbul olunmur)
#   SHOPIFY_STORE_DOMAIN        (<ad>.myshopify.com)
#   SHOPIFY_API_VERSION         (istəyə bağlı, YYYY-MM)
# Canlı oxuma testi: yuxarıdakıları mühitə ver və  npm run test:live:integrations
