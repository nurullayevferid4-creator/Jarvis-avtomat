# TikTok AI Manager: NÜMUNƏ fayl. Real dəyərləri BURAYA YAZMA (repo açıqdır).
# Real dəyərlər: lokal .env (gitignore) və ya Cloudflare/GitHub Secrets.

# --- TikTok for Developers > App (Login Kit + Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# App-da qeydiyyatdan keçmiş redirect URI (dəqiq eyni olmalıdır)
TIKTOK_REDIRECT_URI=
# Vergüllə scope-lar (standart: user.info.basic,user.info.profile,user.info.stats,video.list,video.publish,video.upload)
TIKTOK_SCOPES=

# --- OAuth-dan sonra alınan tokenlər (24 saat / 365 gün) ---
# Tövsiyə: env əvəzinə token faylı (TIKTOK_TOKEN_FILE, standart tiktok-manager/.secrets/token.json, 0600)
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_TOKEN_FILE=

# --- Davranış ---
# Hazırda yalnız v2 dəstəklənir
TIKTOK_API_VERSION=v2
# Real icra (publish). Standart: false. Yalnız təsdiq + bu bayraq true olanda icra olur.
TIKTOK_EXECUTE_ENABLED=false
# TikTok app audit olunubmu? false olduqda paylaşım yalnız SELF_ONLY (TikTok qaydası).
TIKTOK_APP_AUDITED=false
# Hesab məlumatlarının saxlandığı qovluq (standart tiktok-manager/workspace)
TIKTOK_WORKSPACE_DIR=
# 1 = mock rejimi (heç bir real şəbəkə çağırışı yoxdur, test üçün)
TIKTOK_MOCK=

# --- Gələcək: TikTok API for Business (şərh/DM/insights). Hələ istifadə olunmur, bax README. ---
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_SECRET=
TIKTOK_BUSINESS_ACCESS_TOKEN=
